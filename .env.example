# ─────────────────────────────────────────────────────────────────────────────
# YouTube Credentials
# ─────────────────────────────────────────────────────────────────────────────
# Path to the OAuth 2.0 client secrets JSON file downloaded from:
#   Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Download the JSON and place it in the project root (or any path you prefer).
YOUTUBE_CLIENT_SECRETS_PATH=client_secrets.json

# ─────────────────────────────────────────────────────────────────────────────
# TikTok Credentials
# ─────────────────────────────────────────────────────────────────────────────
# Obtain these from the TikTok Developer Portal:
#   https://developers.tiktok.com/apps/
# Your app must have the "Content Posting API" product enabled.
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here

# The redirect URI registered in your TikTok app settings.
# Must match exactly — including the trailing path segment.
TIKTOK_REDIRECT_URI=http://localhost:8080/callback

# ─────────────────────────────────────────────────────────────────────────────
# General Settings
# ─────────────────────────────────────────────────────────────────────────────
# Directory where OAuth tokens are cached locally (relative or absolute path).
# This directory is gitignored — never commit token files.
TOKEN_DIR=tokens
